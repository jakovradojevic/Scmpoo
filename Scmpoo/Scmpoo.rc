106 CURSOR MOVEABLE PURE "106.cur"

107 DIALOGEX 0, 0, 236, 148
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX "Options", -1, 12, 8, 212, 100
    CONTROL "Crying", 1002, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_AUTOCHECKBOX, 24, 28, 180, 14
    CONTROL "Hourly chime", 1001, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_AUTOCHECKBOX, 24, 46, 180, 14
    CONTROL "Always move", 1003, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_AUTOCHECKBOX, 24, 64, 180, 14
    CONTROL "Gravity always on", 1004, "BUTTON", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_AUTOCHECKBOX, 24, 82, 180, 14
    PUSHBUTTON "Exit", IDABORT, 12, 120, 50, 18
    PUSHBUTTON "&Help", IDRETRY, 66, 120, 50, 18
    DEFPUSHBUTTON "OK", IDOK, 122, 120, 50, 18
    PUSHBUTTON "Cancel", IDCANCEL, 176, 120, 50, 18
END

108 DIALOGEX 0, 0, 292, 228
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Debug"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "Action", -1, 12, 10, 160, 12
    LISTBOX 1040, 12, 24, 168, 172, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_CHILD | WS_VISIBLE | WS_BORDER
    GROUPBOX "Nudge", -1, 192, 18, 88, 100
    PUSHBUTTON "Up", 1032, 218, 36, 36, 20, WS_GROUP | WS_TABSTOP
    PUSHBUTTON "Left", 1034, 200, 60, 36, 20
    PUSHBUTTON "Right", 1035, 240, 60, 36, 20
    PUSHBUTTON "Down", 1033, 218, 84, 36, 20
    LTEXT "Pick an action to play it right away.", -1, 192, 128, 88, 48
    DEFPUSHBUTTON "OK", IDOK, 230, 196, 50, 20, WS_GROUP
END

108 WAVE MOVEABLE PURE "108.wav"
109 WAVE MOVEABLE PURE "109.wav"
110 WAVE MOVEABLE PURE "110.wav"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 1
PRODUCTVERSION 1, 0, 0, 1
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x1L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "CompanyName", "Village Center,Inc.\0"
            VALUE "FileDescription", "Screen Mate Poo\0"
            VALUE "FileVersion", "1, 0, 0, 1\0"
            VALUE "InternalName", "Screen Mate Poo\0"
            VALUE "LegalCopyright", "Copyright (C) 1996\0"
            VALUE "OriginalFilename", "Scmpoo.exe\0"
            VALUE "ProductName", "Screen Mate Poo\0"
            VALUE "ProductVersion", "1, 0, 0, 1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
